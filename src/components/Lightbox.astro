---
---
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <span class="close">&times;</span>
  <span class="prev-arrow" onclick="navigateLightbox(-1, event)">&#10094;</span>
  <span class="next-arrow" onclick="navigateLightbox(1, event)">&#10095;</span>

  <div class="lightbox-wrapper" onclick="event.stopPropagation()">
    <img id="lightbox-img" src="" alt="Enlarged Artwork">
    <div id="lightbox-caption"></div>
  </div>
</div>

<script is:inline>
  let currentImgIndex = 0;
  let galleryImages = [];

  function openLightbox(element) {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');

    galleryImages = Array.from(document.querySelectorAll('.gallery img'));
    currentImgIndex = galleryImages.indexOf(element);

    lightboxImg.src = element.src;
    lightboxCaption.innerHTML = element.getAttribute('data-caption');

    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    document.getElementById('lightbox').style.display = 'none';
    document.body.style.overflow = 'auto';
  }

  function navigateLightbox(step, event) {
    if (event) event.stopPropagation();
    if (galleryImages.length === 0) return;

    currentImgIndex = (currentImgIndex + step + galleryImages.length) % galleryImages.length;
    const nextImage = galleryImages[currentImgIndex];

    document.getElementById('lightbox-img').src = nextImage.src;
    document.getElementById('lightbox-caption').innerHTML = nextImage.getAttribute('data-caption');
  }

  document.addEventListener('keydown', function(event) {
    const lightbox = document.getElementById('lightbox');
    if (lightbox.style.display === 'flex') {
      if (event.key === 'ArrowRight') navigateLightbox(1);
      else if (event.key === 'ArrowLeft') navigateLightbox(-1);
      else if (event.key === 'Escape') closeLightbox();
    }
  });
</script>
