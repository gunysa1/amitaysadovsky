---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<style is:global>
  html, body {
    height: 100%;
  }
  body {
    min-height: 100vh;
    background: url('/images/artist-portrait.jpg') center / cover no-repeat;
  }
  .site-header {
    background: linear-gradient(to bottom, rgba(255,255,255,0.72) 0%, rgba(255,255,255,0) 100%);
    position: relative;
    z-index: 1;
  }
  .site-title a,
  .site-title-he,
  .site-nav a { color: rgba(0,0,0,0.85); }
  .site-nav a:hover,
  .site-nav a.active { color: #000; }
  .site-logo line,
  .site-logo polyline,
  .site-logo path { stroke: rgba(0,0,0,0.85); }
  .site-nav { border-top-color: rgba(0,0,0,0.15); border-bottom-color: rgba(0,0,0,0.15); }
  .site-footer { display: none; }
</style>

<BaseLayout title="Ella Amitay Sadovsky" currentPath="home">
</BaseLayout>
