---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<style is:global>
  html, body {
    height: 100%;
  }
  body {
    min-height: 100vh;
    background: url('/images/artist-portrait.jpg') center / cover no-repeat;
  }
  .site-header {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: relative;
    z-index: 1;
  }
  .site-title a,
  .site-title-he { color: #4a90a4; }
  .site-nav a { color: #888; }
  .site-nav a:hover,
  .site-nav a.active { color: #222; }
  .site-logo line,
  .site-logo polyline,
  .site-logo path { stroke: #4a90a4; }
  .site-nav { border-top-color: rgba(255,255,255,0.3); border-bottom-color: rgba(255,255,255,0.3); }
  .site-footer { display: none; }
</style>

<BaseLayout title="Ella Amitay Sadovsky" currentPath="home">
</BaseLayout>
