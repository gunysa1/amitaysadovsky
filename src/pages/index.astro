---
import BaseLayout from '../layouts/BaseLayout.astro';
import Slideshow from '../components/Slideshow.astro';
import { news } from '../data/news';

const latestNews = news.slice(0, 3);

const slideshowImages = [
  'slideshow-01.jpg',
  'dreams-decipherer-01.jpg',
  'slideshow-03.jpg',
  'slideshow-04.jpg',
  'slideshow-05.jpg',
  '2018-20.jpg',
  '2018-17.jpg',
  '2018-19.jpg',
  '2018-16.jpg',
  '2018-01.jpg',
];
---
<BaseLayout title="Home" currentPath="home">
  <main>
    <div class="home-grid">
      <section class="news-col" aria-label="News">
        <h2 class="page-title">News</h2>

        {latestNews.map((item) => (
          <article class="news-item">
            <div class="news-content">
              {item.dateColor && <div class="prize-category">{item.date}</div>}
              <h3>
                {item.link ? <a href={item.link} style="text-decoration: none; color: inherit;">{item.title}</a> : item.title}
              </h3>
              <div class="solo-show">{item.subtitle}</div>
              {!item.dateColor && <div class="meta">{item.date}</div>}
            </div>
            {item.link ? (
              <a href={item.link}>
                <img src={item.image} alt={item.imageAlt} />
              </a>
            ) : (
              <img src={item.image} alt={item.imageAlt} />
            )}
          </article>
        ))}
      </section>

      <section class="slideshow-section" aria-label="Selected works">
        <Slideshow images={slideshowImages} />
      </section>
    </div>
  </main>
</BaseLayout>
