---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Publications" currentPath="publications">
  <main>
    <h2 class="page-title">Publications</h2>

    <div class="pub">
      <img src="/images/1943986.jpg" alt="Ella Amitay Sadovsky: Spare Parts — book cover">
      <div>
        <h3>Ella Amitay Sadovsky: Spare Parts</h3>
        <p>The book was published in conjunction with the exhibition <em>Ella Amitay Sadovsky: Spare Parts</em>, The Open Museum, Tefen Industrial Park, July 2014 – January 2015.</p>
        <p>Director and Chief Curator, The Open Museums: Ruthi Ofek<br>
        Exhibition Curators: Ruthi Ofek, Amon Yariv</p>
      </div>
    </div>

    <div class="pub">
      <img src="/images/5758013.jpg" alt="Gordon Gallery 2012 — book cover">
      <div>
        <h3>Gordon Gallery 2012</h3>
        <p>The book was published alongside the exhibition <em>2012</em>, at the opening of the Gordon 2 new space for cutting edge contemporary art, with a focus on a younger generation of artists.</p>
      </div>
    </div>

    <div class="pub">
      <img src="/images/6287177.jpg" alt="Short Escape — book cover">
      <div>
        <h3>Short Escape</h3>
        <p>The book was published in conjunction with the exhibition <em>Short Escape</em>, 2012, at Gordon Gallery 2.</p>
      </div>
    </div>
  </main>
</BaseLayout>
