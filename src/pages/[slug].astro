---
import BaseLayout from '../layouts/BaseLayout.astro';
import { works } from '../data/works';

export async function getStaticPaths() {
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
---

<BaseLayout title={work.title}>
  <main>
    <h2 class="page-title">{work.title}</h2>

    {work.video && (
      <div style="margin-bottom: 40px;">
        <iframe src={work.video} width="100%" height="480" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen style="display: block;" />
      </div>
    )}

    {work.intro && <div class="prose" set:html={work.intro} />}
    {work.intro_he && <div class="prose" dir="rtl" set:html={work.intro_he} />}

    <div class={work.medium === 'video' ? 'gallery gallery-2col' : 'gallery'}>
      {work.images.map((image) => (
        <figure>
          <img
            src={image.src}
            alt={image.caption || work.title}
            data-caption={image.caption}
            onclick="openLightbox(this)"
            loading="lazy"
          />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </main>
</BaseLayout>