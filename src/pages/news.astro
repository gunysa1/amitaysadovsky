---
import BaseLayout from '../layouts/BaseLayout.astro';
import { news } from '../data/news';
---
<BaseLayout title="Ella Amitay Sadovsky - News" currentPath="news">
  <main>
    <h2 class="page-title">News</h2>

    {news.map((item) => (
      <article class="news-item" style="display: flex; gap: 30px; margin-bottom: 60px; align-items: flex-start; border-bottom: 1px solid #eee; padding-bottom: 40px;">
        <div class="news-image" style="flex: 0 0 300px;">
          {item.link ? (
            <a href={item.link}>
              <img src={item.image} alt={item.imageAlt} style="width: 100%; height: auto; border-radius: 4px;" />
            </a>
          ) : (
            <img src={item.image} alt={item.imageAlt} style="width: 100%; height: auto; border-radius: 4px;" />
          )}
        </div>
        <div class="news-content">
          <span style={`text-transform: uppercase; font-size: 11px; letter-spacing: 2px; color: ${item.dateColor ?? '#999'};`}>{item.date}</span>
          <h3 style="margin: 10px 0; font-size: 22px; font-weight: normal;">
            {item.link ? (
              <a href={item.link} style="text-decoration: none; color: #222;">{item.title}</a>
            ) : (
              <span style="color: #222;">{item.title}</span>
            )}
          </h3>
          <p style="font-weight: bold; color: #4a90a4; margin-bottom: 10px;">{item.subtitle}</p>
          {item.description && <p style="color: #666; font-size: 14px; line-height: 1.6;">{item.description}</p>}
        </div>
      </article>
    ))}
  </main>
</BaseLayout>
