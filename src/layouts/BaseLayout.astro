---
import '../css/style.css';
import { works, etcLinks } from '../data/works';
const { title, currentPath } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Ella Amitay Sadovsky</title>
  </head>
  <body>
    <header class="site-header">
      <div class="title-row">
        <h1 class="site-title"><a href="/">ELLA AMITAY SADOVSKY</a></h1>
        <div class="site-title-he">אלה אמיתי סדובסקי&nbsp;</div>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <ul>
          <li><a href="/" class={currentPath === 'home' ? 'active' : ''}>Home</a></li>
          <li class="has-sub">
            <a href="#" aria-haspopup="true">Works</a>
            <ul class="submenu">
              {works.map((work) => (
                <li><a href={`/${work.slug}`}>{work.title}</a></li>
              ))}
            </ul>
          </li>
          <li class="has-sub">
            <a href="#" aria-haspopup="true">Etc</a>
            <ul class="submenu">
              {etcLinks.map((link) => (
                <li><a href={`/${link.slug}`}>{link.title}</a></li>
              ))}
            </ul>
          </li>
          <li><a href="/about" class={currentPath === 'about' ? 'active' : ''}>About</a></li>
          <li><a href="/contact" class={currentPath === 'contact' ? 'active' : ''}>Contact</a></li>
        </ul>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-left">© Ella Amitay Sadovsky</div>

      <div class="social">
        <a href="https://www.facebook.com/amitaysadovsky" aria-label="Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.2-1.4 1.4-1.4h1.5V5.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.1H8v2.8h2.5V21z"/></svg>
        </a>
        <a href="https://www.instagram.com/ella.amitay.sadovsky/" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor"/></svg>
        </a>
      </div>

      <div class="footer-right">אלה אמיתי סדובסקי ©</div>
    </footer>

    <!-- Lightbox Overlay -->
    <div id="lightbox" class="lightbox">
      <span class="close">&times;</span>
      <span class="prev-arrow">&#10094;</span>
      <span class="next-arrow">&#10095;</span>
      <div class="lightbox-wrapper">
        <img id="lightbox-img" src="" alt="">
        <div id="lightbox-caption"></div>
      </div>
    </div>

    <script>
      // Global Lightbox logic can be initialized here
    </script>
  </body>
</html>