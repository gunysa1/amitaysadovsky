---
import { etcLinks } from '../data/works';
const { title, currentPath } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Ella Amitay Sadovsky</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="title-row">
        <div class="title-left">
          <h1 class="site-title"><a href="/">ELLA AMITAY SADOVSKY</a></h1>
        </div>
        <div class="site-title-he">אלה אמיתי סדובסקי&nbsp;</div>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <ul>
          <li><a href="/" class={currentPath === 'home' ? 'active' : ''}>Home</a></li>
          <li><a href="/video" class={currentPath === 'video' ? 'active' : ''}>Video</a></li>
          <li><a href="/canvas" class={currentPath === 'canvas' ? 'active' : ''}>Canvas</a></li>
          <li><a href="/paper" class={currentPath === 'paper' ? 'active' : ''}>Paper</a></li>
          <li class="has-sub">
            <a href="#" aria-haspopup="true">Etc</a>
            <ul class="submenu">
              {etcLinks.map((link) => (
                <li><a href={`/${link.slug}`}>{link.title}</a></li>
              ))}
            </ul>
          </li>
          <li><a href="/about" class={currentPath === 'about' ? 'active' : ''}>About</a></li>
          <li><a href="/contact" class={currentPath === 'contact' ? 'active' : ''}>Contact</a></li>
        </ul>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-left">© Ella Amitay Sadovsky</div>

      <div class="social">
        <a href="https://www.facebook.com/amitaysadovsky" aria-label="Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.2-1.4 1.4-1.4h1.5V5.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.1H8v2.8h2.5V21z"/></svg>
        </a>
        <a href="https://www.instagram.com/ella.amitay.sadovsky/" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor"/></svg>
        </a>
      </div>

      <div class="footer-right">אלה אמיתי סדובסקי ©</div>
    </footer>

    <div id="lightbox" class="lightbox" onclick="closeLightbox()">
      <span class="close">&times;</span>
      <span class="prev-arrow" onclick="navigateLightbox(-1, event)">&#10094;</span>
      <span class="next-arrow" onclick="navigateLightbox(1, event)">&#10095;</span>
      <div class="lightbox-wrapper" onclick="event.stopPropagation()">
        <img id="lightbox-img" src="" alt="">
        <div id="lightbox-caption"></div>
      </div>
    </div>

    <script is:inline>
      let currentImgIndex = 0;
      let galleryImages = [];

      function openLightbox(element) {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        galleryImages = Array.from(document.querySelectorAll('.gallery img'));
        currentImgIndex = galleryImages.indexOf(element);
        lightboxImg.src = element.src;
        lightboxCaption.innerHTML = element.getAttribute('data-caption') || '';
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
        document.body.style.overflow = 'auto';
      }

      function navigateLightbox(step, event) {
        if (event) event.stopPropagation();
        if (galleryImages.length === 0) return;
        currentImgIndex = (currentImgIndex + step + galleryImages.length) % galleryImages.length;
        const nextImage = galleryImages[currentImgIndex];
        document.getElementById('lightbox-img').src = nextImage.src;
        document.getElementById('lightbox-caption').innerHTML = nextImage.getAttribute('data-caption') || '';
      }

      document.addEventListener('keydown', function(event) {
        const lightbox = document.getElementById('lightbox');
        if (lightbox.style.display === 'flex') {
          if (event.key === 'ArrowRight') navigateLightbox(1);
          else if (event.key === 'ArrowLeft') navigateLightbox(-1);
          else if (event.key === 'Escape') closeLightbox();
        }
      });
    </script>
  </body>
</html>